# Copy to /etc/futu-opend.env (or run ./deploy/gcp/configure-opend-paths.sh to auto-fill paths).
FUTU_ACCOUNT=your_futu_account_id
FUTU_PASSWORD=your_futu_login_password
# REAL trading only (systemd / non-interactive):
# FUTU_TRADE_PASSWORD=your_trade_password
LISTEN_IP=127.0.0.1
LISTEN_PORT=11111

# Auto-detected by configure-opend-paths.sh, e.g.:
# OPEND_HOME=/opt/futu-opend/Futu_OpenD_10.7.6728_Ubuntu18.04
# OPEND_CFG_FILE=/opt/futu-opend/Futu_OpenD_10.7.6728_Ubuntu18.04/FutuOpenD.xml
