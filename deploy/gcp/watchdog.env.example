# Copy to ~/.config/robs/watchdog.env on the GCP VM (chmod 600).
# ntfy push alerts — no SMTP password. Subscribe in the ntfy app to your topic.

# Pick a long random topic name (anyone with this name gets your alerts).
WATCHDOG_NTFY_TOPIC=robs-mhimain-CHANGE_ME

# Default public server; or your self-hosted ntfy URL
WATCHDOG_NTFY_SERVER=https://ntfy.sh

# Optional: ntfy access token for private/paid topics
# WATCHDOG_NTFY_TOKEN=

# Minutes between repeat DOWN alerts while still down
WATCHDOG_COOLDOWN_MIN=60
